# Supabase Connection (Production / Vercel)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key

# Session Encryption Key
# Generate any long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=your-32-byte-secret-encryption-key-min-32-chars
